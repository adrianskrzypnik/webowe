{
  "name": "galeria-optymalizacja",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "images:download": "node scripts/download-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "typecheck": "tsc --noEmit",
    "build:v0": "vite build --mode v0",
    "build:v1": "vite build --mode v1",
    "build:v2": "vite build --mode v2",
    "build:v12": "vite build --mode v12",
    "build:all": "npm run build:v0 && npm run build:v1 && npm run build:v2 && npm run build:v12",
    "serve:v0": "node scripts/serve.mjs v0 4170",
    "serve:v1": "node scripts/serve.mjs v1 4171",
    "serve:v2": "node scripts/serve.mjs v2 4172",
    "serve:v12": "node scripts/serve.mjs v12 4173",
    "measure:v0": "node scripts/measure.mjs v0",
    "measure:v1": "node scripts/measure.mjs v1",
    "measure:v2": "node scripts/measure.mjs v2",
    "measure:v12": "node scripts/measure.mjs v12",
    "measure:all": "npm run measure:v0 && npm run measure:v1 && npm run measure:v2 && npm run measure:v12",
    "report": "node scripts/report.mjs && node scripts/analyze.mjs",
    "images:prepare": "node scripts/prepare-baseline.mjs"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "react": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
